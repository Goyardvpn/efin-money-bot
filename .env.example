# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен Telegram-бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID администратора (необязательно, по умолчанию берётся значение из config.py)
# ADMIN_ID=

# Ключ TokenBoom API для Efin AI
TOKENBOOM_API_KEY=

# Токен GitHub для чтения базы знаний (подойдёт любая из трёх переменных)
GITHUB_TOKEN=
# GH_TOKEN=
# EFIN_KB_TOKEN=

# Репозиторий и ветка базы знаний (необязательно)
# EFIN_KB_REPO=Goyardvpn/efin-knowledge-base
# EFIN_KB_BRANCH=main

# Утренняя рассылка 07:00 МСК (погода + цитата), необязательно
# DAILY_DIGEST=off            # отключить рассылку
# DAILY_DIGEST_ONLY_ADMIN=1   # слать только администратору (для проверки)
